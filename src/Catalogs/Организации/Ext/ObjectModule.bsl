
Процедура ПередЗаписью(Отказ)
    Если Не ПроверитьИННПоТипуОрганизации(ИНН, ТипОрганизации) Тогда
        Отказ = Истина;
    КонецЕсли;
КонецПроцедуры

Функция ПроверитьИННПоТипуОрганизации(ЗначениеИНН, ЗначениеТипОрганизации) Экспорт
	
	// Убираем пробелы по краям
	ИНН = СокрЛП(ЗначениеИНН); 

    // Определяем ожидаемую длину в зависимости от типа организации
    ОжидаемаяДлина = 0;

    Если ЗначениеТипОрганизации = ПредопределенноеЗначение("Перечисление.ТипыОрганизаций.ЮридическоеЛицо") Тогда
        ОжидаемаяДлина = 10;
    ИначеЕсли ЗначениеТипОрганизации = ПредопределенноеЗначение("Перечисление.ТипыОрганизаций.ИндивидуальныйПредприниматель") Тогда
        ОжидаемаяДлина = 12;
    КонецЕсли;

    // Проверяем длину ИНН
    ФактическаяДлина = СтрДлина(ИНН);  
	
    Если ФактическаяДлина <> ОжидаемаяДлина Тогда
        ТекстОшибки = СтрШаблон(
            "Для %1 длина ИНН должна составлять %2 цифр. Введено: %3 символов.",
            ЗначениеТипОрганизации,
            ОжидаемаяДлина,
            ФактическаяДлина
        );
        ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
        Возврат Ложь;
    КонецЕсли;


    Возврат Истина;
КонецФункции            









